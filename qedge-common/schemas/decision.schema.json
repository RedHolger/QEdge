{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qedge.local/schemas/decision.schema.json",
  "title": "QEdge evidence decision",
  "description": "A verdict over all required attributes. Any contradiction blocks a recommendation; missing evidence must abstain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "query",
    "item_id",
    "status",
    "action",
    "reason",
    "claims",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "item_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": ["SUPPORTED", "CONTRADICTED", "UNKNOWN", "ABSTAIN"]
    },
    "action": {
      "enum": ["RECOMMEND", "DO_NOT_RECOMMEND", "ABSTAIN"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SUPPORTED" } }, "required": ["status"] },
      "then": { "properties": { "action": { "const": "RECOMMEND" } } }
    },
    {
      "if": { "properties": { "status": { "const": "CONTRADICTED" } }, "required": ["status"] },
      "then": { "properties": { "action": { "const": "DO_NOT_RECOMMEND" } } }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["UNKNOWN", "ABSTAIN"] } },
        "required": ["status"]
      },
      "then": { "properties": { "action": { "const": "ABSTAIN" } } }
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "claim_id",
        "item_id",
        "attribute",
        "operator",
        "required_value",
        "required_unit",
        "observed_value",
        "observed_unit",
        "status",
        "source",
        "source_revision",
        "evidence_text",
        "retrieved_at"
      ],
      "properties": {
        "schema_version": { "const": "1" },
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "attribute": { "type": "string", "minLength": 1, "maxLength": 64 },
        "operator": { "enum": ["<=", ">=", "==", "contains"] },
        "required_value": { "type": ["string", "boolean", "integer", "number"] },
        "required_unit": { "type": ["string", "null"], "maxLength": 16 },
        "observed_value": {
          "type": ["string", "boolean", "integer", "number", "null"]
        },
        "observed_unit": { "type": ["string", "null"], "maxLength": 16 },
        "status": { "enum": ["SUPPORTED", "CONTRADICTED", "UNKNOWN"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 256 },
        "evidence_text": { "type": "string", "maxLength": 4096 },
        "retrieved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
