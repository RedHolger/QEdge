{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qedge.local/schemas/retrieval_result.schema.json",
  "title": "QEdge retrieval result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "catalog_version",
    "model_version",
    "index_version",
    "candidates",
    "timing",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "catalog_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "index_version": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ranker_version": { "type": ["string", "null"], "maxLength": 256 },
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "timing": { "$ref": "#/$defs/timing" },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 512 }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "rank", "score"],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "rank": { "type": "integer", "minimum": 1, "maximum": 100 },
        "score": { "type": "number" },
        "component_scores": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encode_ms", "retrieve_ms", "rerank_ms", "total_ms"],
      "properties": {
        "encode_ms": { "type": "number", "minimum": 0 },
        "retrieve_ms": { "type": "number", "minimum": 0 },
        "rerank_ms": { "type": "number", "minimum": 0 },
        "total_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
